meta {
  name: Registrar Excepcion Feriado
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/horarios/excepciones
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "tipo": "feriado",
    "fecha": "2026-12-08",
    "sucursal_id": "sucursal-centro",
    "motivo": "Feriado nacional"
  }
}

tests {
  test("status code is 201", function() {
    expect(res.getStatus()).to.equal(201);
  });
